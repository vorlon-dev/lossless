# ─── Antra Flux (web platform) configuration ─────────────────────────────────
# Copy to .env (local) or set in Cloudflare → Worker → Settings → Variables.

# Base URL of your self-hosted Antra gateway (see /gateway folder).
# Leave empty to serve the built-in demo catalog.
ANTRA_GATEWAY_URL=

# Optional shared secret. When set, /api/* clients must send header
# "x-api-key: <value>" (or ?key=<value>).
ANTRA_API_KEY=
