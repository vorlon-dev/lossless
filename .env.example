# ─── Antra Flux — environment variables ──────────────────────────────────────
# All optional. Copy to .env (local dev) or set as Worker vars/secrets.

# Base URL of your YTM metadata backend (search / albums / artists / lyrics).
# Defaults to the built-in worker when unset.
ANTRA_GATEWAY_URL=https://ytm-backend.vorlon-revora.workers.dev

# Optional shared secret — clients must send header "x-api-key: <key>" or ?key=
ANTRA_API_KEY=

# Optional playback resolver. {id} is replaced with the YouTube video id.
# /api/stream/{id} 302-redirects there; unset = metadata-only mode (502).
ANTRA_STREAM_TEMPLATE=
